# PostgreSQL Configuration (Local Development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=efi_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Superuser Database URL (for running schema migrations)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/efi_dev?sslmode=disable

# Least-Privilege Application User Credentials (created in 0001_init.sql)
APP_DB_USER=efi_app
APP_DB_PASSWORD=efi_app_pass
APP_DATABASE_URL=postgres://efi_app:efi_app_pass@localhost:5432/efi_dev?sslmode=disable

# Telegram API Credentials (obtain from https://my.telegram.org)
# In accordance with ADR-0005, never commit session strings or API credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Monitored Public Channels (comma-separated usernames or numeric channel IDs)
TELEGRAM_CHANNELS=@ena_news,@fana_broadcast

# V3 Semantic Clustering / Embedding Configuration (ADR-0007)
# Google Gemini API key for text-embedding-004 and text generation
GEMINI_API_KEY=
EMBEDDING_HIGH_THRESHOLD=0.82
EMBEDDING_LOW_THRESHOLD=0.65
MAX_EMBEDDING_RETRIES=3

# V4 AI Enrichment Configuration (ADR-0008)
LLM_MODEL=gemini-flash-latest
VERIFY_CONFIDENCE_THRESHOLD=0.75
STABILITY_WINDOW_MINUTES=15
MAX_LLM_RETRIES=3

# V5 Public API Configuration (ADR-0009)
API_DB_USER=efi_api
API_DB_PASSWORD=efi_api_pass
API_PORT=8080
API_DATABASE_URL=postgres://efi_api:efi_api_pass@localhost:5432/efi_dev?sslmode=disable
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
MAX_PAGINATION_LIMIT=50
CORS_ALLOWED_ORIGINS=*

# Runtime Configuration
POLL_INTERVAL_SECONDS=2
BATCH_SIZE=50
SIMHASH_THRESHOLD=10
CLUSTERING_WINDOW_HOURS=48
RECONNECT_DELAY_SECONDS=5
MAX_RECONNECT_RETRIES=10
ENVIRONMENT=development
LOG_LEVEL=INFO

